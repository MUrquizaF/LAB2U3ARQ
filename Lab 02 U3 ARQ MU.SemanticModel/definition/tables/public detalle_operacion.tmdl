table 'public detalle_operacion'
	lineageTag: d73adbb1-de93-47aa-a178-a2c7b6663937

	measure 'Importe Total' = ```
			
			        SUMX(
			            'public detalle_operacion', 
			            'public detalle_operacion'[cantidad] * 'public detalle_operacion'[precio_unitario] * (1 - DIVIDE('public detalle_operacion'[descuento], 100))
			        )
			```
		lineageTag: c6f116d4-af2f-43ed-81c3-d3971a133c69

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe Completado' = ```
			
			        CALCULATE(
			            [Importe Total],
			            'public operaciones'[estado] = "Completada"
			        )
			```
		lineageTag: 57bb59ce-fbfc-4af6-9d82-2a4a081c6f4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Operaciones' = ```
			
			        DISTINCTCOUNT('public detalle_operacion'[operacion_id])
			```
		formatString: 0
		lineageTag: 3bae6744-8a52-46fe-a1a5-57c47cbd1b7c

